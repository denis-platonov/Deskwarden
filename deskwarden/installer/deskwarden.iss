; deskwarden/installer/deskwarden.iss
;
; Per-user Inno Setup installer for deskwarden. No admin rights / UAC prompt
; required (PrivilegesRequired=lowest, installs under %LOCALAPPDATA%).
;
; Build-time dependency: Inno Setup 6 (ISCC.exe) only.
;
; INSTALL is declarative: it copies two files, offers the autostart checkbox
; and finishes -- no [Code] runs on that side, and none may be added to it.
; UNINSTALL has a [Code] section, at the bottom of this file, for the two
; leftovers that cannot be expressed as a rule: the checkbox that offers to
; delete the user's data, and the two registry entries that are removed only
; if they still point at this installation. See installer/README.md for full
; build instructions.
;
; Build with:
;   iscc deskwarden.iss /DAppVersion=0.1.0
;
#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif

[Setup]
AppId={{63CBCB72-5383-4AE7-AFB7-5EE0530E4630}
AppName=Deskwarden
AppVersion={#AppVersion}
AppPublisher=deskwarden (unofficial, unaffiliated with Bitwarden, Inc.)
DefaultDirName={localappdata}\Deskwarden
DefaultGroupName=Deskwarden
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
; ------------------------------------------------------------------
; Installing over a RUNNING Deskwarden.
;
; Without the three directives below, setup had no idea the app was running:
; it went straight to copying over a deskwarden.exe that Windows had mapped
; as a running image, so the install failed or left a stale binary. The app
; now creates this exact mutex as the first statement of `fn main` and holds
; it for its whole life (src/app_mutex.rs), so Inno's OpenMutex on it finds
; the running copy and shows "please close Deskwarden, then click OK".
;
; The name is AUTHORED IN ONE PLACE, `app_mutex::APP_MUTEX_NAME`, and merely
; copied here because Inno cannot read a Rust constant. It is not kept in
; sync by hand or by hope: the test
; `app_mutex::tests::the_installer_names_the_same_mutex_this_process_creates`
; include_str!s THIS FILE, parses this line, and fails the build if the two
; ever differ. Change it there first.
;
; `Local\` and not `Global\` on purpose: PrivilegesRequired=lowest and
; DefaultDirName={localappdata} above make this a per-user install, so setup
; runs in the same logon session as the app it is replacing. A global mutex
; would additionally let one user's running copy block a different user's
; install of their own private copy.
AppMutex=Local\Deskwarden-63CBCB72-5383-4AE7-AFB7-5EE0530E4630
;
; And setup ASKS rather than force-closing. Inno 6's Restart Manager could
; close the app for us (CloseApplications=yes, which is the default when
; files are found in use), and for this app that is the wrong answer: a
; Restart Manager close is a TerminateProcess, which runs no destructors and
; no exit path. Deskwarden's clean shutdown takes a copied password back off
; the Windows clipboard (clipboard::clear_if_still_ours_for) and every secret
; in the app zeroizes on drop -- so a force-close would leave the user's
; password sitting on their clipboard and their secrets unwiped in freed
; memory, as a side effect of installing an update. The mutex above makes the
; app exit through its own door instead.
;
; What this gives up: there is now NO automatic fallback. If deskwarden.exe
; is locked by something that does not hold the mutex -- most importantly a
; copy of version 0.8.0 or earlier, which predates the mutex entirely -- setup
; will report a file in use rather than quietly closing it. That first upgrade
; still has to be done with the app closed by hand; every one after it prompts.
CloseApplications=no
RestartApplications=no
; ------------------------------------------------------------------
OutputBaseFilename=deskwarden-{#AppVersion}-installer
; Compiled installer lands directly in installer/, matching what
; .github/workflows/release.yml (Task 6) expects to find and publish --
; without this, Inno's default OutputDir ("Output\" relative to this
; script) would put it one level down from where the release workflow
; looks.
OutputDir=.
Compression=lzma2
SolidCompression=yes
; Uninstall takes a directory back off the user's `PATH` (see [Code]), and a
; PATH change nothing announces is invisible to every process already running
; -- the user's open terminals keep offering a command whose directory has
; just been deleted, until they sign out. This directive is the whole reason
; the announcement needs no code: Inno broadcasts WM_SETTINGCHANGE itself,
; after install AND after uninstall. `bw_acquire`'s own PATH write broadcasts
; the same message for the same reason; this is the uninstall half of it.
ChangesEnvironment=yes
; The app's own icon (generated by ../assets/generate-icon.py and embedded
; into deskwarden.exe by build.rs), reused for setup's window/taskbar entry
; and for the Programs-and-Features entry, so the installer, the app, the
; Start Menu shortcut and the uninstall entry all look like the same product.
SetupIconFile=..\assets\deskwarden.ico
UninstallDisplayIcon={app}\deskwarden.exe

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\target\release\deskwarden.exe"; DestDir: "{app}"; Flags: ignoreversion
; The passphrase word list. `src/password_gen.rs` reads it from beside the
; executable ON DEMAND rather than carrying it in the binary, so this line is
; not optional decoration: without it the installed app refuses every
; passphrase while a development build generates them happily, which is a
; defect nobody sees until release. `WORDLIST_FILE` there is the same
; spelling, and `the_installer_ships_the_wordlist_this_module_reads` reads
; THIS FILE to hold the two together so the name cannot drift.
Source: "..\assets\wordlist.txt"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\Deskwarden"; Filename: "{app}\deskwarden.exe"

[Registry]
; HKCU, not HKLM: this is a per-user install with no admin rights, and
; autostart should only apply to the user who installed it. Uninstall
; removes this value automatically via uninsdeletevalue.
;
; `--autostart` is how the app tells a LOGIN start from a DOUBLE-CLICK. The
; owner: "if user launched it - it should show up (not go to tray), if it
; autostart with minimized - it goes to tray." Without an argument the two
; launches are byte-identical -- same exe, same empty command line, same
; working directory -- so there is nothing for the app to decide on. `main`'s
; `launch_intent` reads it; `AUTOSTART_FLAG` there is the same spelling and
; `the_installers_run_entry_passes_the_flag_the_app_reads` holds the two
; together by reading THIS FILE, so the spelling cannot drift.
;
; **Existing installs do not have it, and that is handled by the app rather
; than here.** This line only runs when the `autostart` task is selected, and
; a self-update deliberately passes /MERGETASKS=!autostart (see [Tasks]
; below), so an upgrade never rewrites a Run value that is already there. A
; user who does not reinstall keeps a bare `deskwarden.exe` indefinitely.
; `launch_intent` therefore reads a missing flag as a USER launch: that is
; what those installs do today, so nothing about them changes, and of the two
; ways to be wrong -- showing a window nobody asked for, or silently going to
; the tray when somebody double-clicked -- only the first is recoverable by
; the user. See `launch_intent`'s own doc for the whole argument.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "Deskwarden"; ValueData: """{app}\deskwarden.exe"" --autostart"; Flags: uninsdeletevalue; Tasks: autostart

[Tasks]
; No `checkedonce`: this task is checked by default on EVERY interactive
; install, not only the first. `checkedonce` limits the checked default to a
; first install, so every upgrade -- including one a user started by hand --
; offered the box already cleared, which contradicted README's "on by
; default, opt-out checkbox" for everyone past their first install.
;
; This is only safe because the self-update passes /MERGETASKS=!autostart
; (updater.rs::launch_installer). A silent update applies the DEFAULT task
; set, so without that flag this line would silently write the Run key back
; for a user who had deliberately cleared it -- an unattended change to a
; system setting, which is worse than the wrong default it fixes. The two
; belong together; changing either alone reintroduces one of the bugs.
Name: "autostart"; Description: "Start Deskwarden automatically when you sign in"

[Run]
; Relaunch Deskwarden once setup finishes. Required by the design spec's
; Auto-update section ("with the installer configured to relaunch the app
; after completing"), and load-bearing for the self-update path: updater.rs's
; apply_update launches this installer and the running app then exits, so
; without this the user clicks "Update available" and Deskwarden simply
; disappears until the next sign-in -- or forever, if they declined the
; autostart task.
;
; `postinstall` runs the entry after setup completes in *both* interactive
; and /VERYSILENT modes. `skipifsilent` is deliberately NOT used: the update
; path is precisely the silent one, and it is the case that most needs the
; relaunch. `nowait` because Deskwarden is a long-lived tray app -- setup
; must not sit waiting for the user to quit it.
Filename: "{app}\deskwarden.exe"; Description: "Start Deskwarden"; Flags: postinstall nowait

[UninstallDelete]
; **Everything below was created at RUNTIME, so Inno does not know it exists.**
;
; Inno's uninstaller removes exactly what setup copied -- deskwarden.exe and
; wordlist.txt -- and then leaves {app} standing, because the directory is not
; empty. It is not empty because the running app wrote into it: the icon cache
; grows under the user's local cache directory, and the app creates {app}\bin
; and downloads a helper into it the first time a server is chosen that needs
; one. Measured on a real machine after the owner deleted the app: 4.4 MB of
; cached site icons and a leftover bin\ directory, still there.
;
; None of this is user-authored content. It is a cache the app filled, a
; directory the app created inside its own install location, and a program the
; app downloaded into that directory. A plain uninstall takes all of it,
; because "uninstall" that leaves the install directory behind is not one.
;
; The cache paths are spelled absolutely rather than as {app}\... because they
; come from `directories::ProjectDirs`, which resolves against the user's
; known folders and does NOT follow a moved install. On a default install
; these ARE inside {app}; on a relocated one they are not, and both must go.
; `settings.rs` authors the first root ("dev"/"Deskwarden"/"Deskwarden") and
; `bw_acquire.rs`'s scratch directory the second (an empty organization, hence
; the shorter path).
Type: filesandordirs; Name: "{app}\bin"
Type: filesandordirs; Name: "{localappdata}\Deskwarden\Deskwarden\cache"
Type: filesandordirs; Name: "{localappdata}\deskwarden\cache\bw-cli"
; RemoveDir semantics: these four only go if nothing else is left in them, so
; a relocated install that shares a parent with something else cannot lose it.
Type: dirifempty; Name: "{localappdata}\Deskwarden\Deskwarden"
Type: dirifempty; Name: "{localappdata}\deskwarden\cache"
Type: dirifempty; Name: "{localappdata}\Deskwarden"
Type: dirifempty; Name: "{app}"

[Code]
// **This section exists for the UNINSTALL path only, and nothing else.**
//
// Note the comment marker: inside [Code] this file stops being an Inno script
// and becomes Pascal, where a leading `;` is not a comment but a statement
// separator. A `;`-commented block here does compile -- right up until the
// compiler reaches the first word it does not know and reports `'BEGIN'
// expected` on the line the block STARTS on. That is what it looks like when
// this is got wrong, which is worth knowing, because it happened here.
//
// The install side is still declarative and must stay that way: it copies an
// app and finishes, it fetches and verifies nothing, and it starts no external
// process. What used to be here -- a wizard page, a helper script, a signature
// check and four dialogs, all for a dependency that only some accounts need
// and that ran before the user had chosen a server -- is recorded in
// installer/README.md under "What this installer no longer does". The app
// acquires that dependency itself now: see src/bw_acquire.rs.
//
// Three tests in src/main.rs hold this file to that:
// `the_installer_says_nothing_about_the_bitwarden_cli`,
// `the_installer_shells_out_to_nothing`, and
// `the_bootstrap_script_is_not_in_the_tree`. They are text scans of this whole
// file, so a MENTION in a comment here reads exactly like a call -- which is
// why the history, and the naming of what {app}\bin holds, live in the README
// rather than in this file. Nothing below starts a process or names a binary.
//
// Why code at all, when [UninstallDelete] above is declarative? Because the
// two remaining leftovers are CONDITIONAL, and a declarative rule cannot ask
// the question:
//
//   1. The user's vault data must only be deleted if they ask for it, so
//      somebody has to be shown a checkbox and the answer has to be read.
//   2. The logon entry and the PATH entry must only be removed if they still
//      point at THIS installation. Deleting a registry value because it shares
//      a name with ours, or an unrelated PATH entry, is the kind of damage an
//      uninstaller has no way to apologise for.

const
  LogonKey = 'Software\Microsoft\Windows\CurrentVersion\Run';
  LogonValueName = 'Deskwarden';
  EnvironmentKey = 'Environment';
  PathValueName = 'Path';

var
  DeleteUserData: Boolean;

// ---- the checkbox -------------------------------------------------------

// Asks whether the user's data goes too, and whether to go on at all.
//
// DEFAULT UNCHECKED, deliberately. Deleting somebody's settings, their
// signed-in accounts and the key that decrypts their vault must be a thing
// they chose, not a thing they failed to prevent -- and the most common
// uninstall by far is one half of a reinstall or a downgrade, where destroying
// the data would be pure loss. The option is a dialog of its own rather than a
// line in a summary, so that "unchecked by default" does not shade into
// "hidden": a user who wants their data gone cannot miss this, and a user who
// wants it kept does not have to do anything.
function AskWhetherToDeleteUserData(var DeleteData: Boolean): Boolean;
var
  Form: TSetupForm;
  Intro, Detail: TNewStaticText;
  Box: TNewCheckBox;
  Proceed, Stop: TNewButton;
  ButtonWidth: Integer;
begin
  Result := False;
  DeleteData := False;
  // Client size, then centre-on-screen and keep-vertical-size, matching the
  // shape Inno's own Examples\CodeClasses.iss uses. The size is fixed rather
  // than fitted to the text because every string below is this file's own and
  // none of them is translated.
  Form := CreateCustomForm(ScaleX(452), ScaleY(232), True, True);
  try
    Form.Caption := 'Uninstall Deskwarden';

    Intro := TNewStaticText.Create(Form);
    Intro.Parent := Form;
    Intro.Left := ScaleX(16);
    Intro.Top := ScaleY(16);
    Intro.Width := Form.ClientWidth - ScaleX(32);
    Intro.WordWrap := True;
    Intro.AutoSize := True;
    // Says what is actually left behind, in the four things a person owns --
    // not "application data". The key is named last and named plainly,
    // because it is the one that still unlocks the vault after the app is
    // gone, and the app's own Preferences screen says it never expires.
    Intro.Caption :=
      'Removing Deskwarden does not remove your data. Your settings, the' + #13#10 +
      'accounts you are signed in to, the encrypted copy of your vault and' + #13#10 +
      'the key that unlocks it stay on this computer, under' + #13#10 +
      ExpandConstant('{userappdata}\Deskwarden') + '.';

    Box := TNewCheckBox.Create(Form);
    Box.Parent := Form;
    Box.Left := ScaleX(16);
    Box.Top := Intro.Top + Intro.Height + ScaleY(18);
    Box.Width := Form.ClientWidth - ScaleX(32);
    Box.Height := ScaleY(19);
    Box.Checked := False;
    // The owner's words, kept: "also delete all data and settings".
    Box.Caption := 'Also delete all data and settings';

    Detail := TNewStaticText.Create(Form);
    Detail.Parent := Form;
    Detail.Left := ScaleX(32);
    Detail.Top := Box.Top + Box.Height + ScaleY(6);
    Detail.Width := Form.ClientWidth - ScaleX(48);
    Detail.WordWrap := True;
    Detail.AutoSize := True;
    Detail.Caption :=
      'Deletes that folder, the key included. This cannot be undone.' + #13#10 +
      'Leave it clear if you are reinstalling or changing versions.';

    Stop := TNewButton.Create(Form);
    Stop.Parent := Form;
    Stop.Height := ScaleY(23);
    Stop.Top := Form.ClientHeight - ScaleY(23 + 10);
    Stop.Caption := 'Cancel';
    Stop.ModalResult := mrCancel;
    Stop.Cancel := True;

    Proceed := TNewButton.Create(Form);
    Proceed.Parent := Form;
    Proceed.Height := Stop.Height;
    Proceed.Top := Stop.Top;
    Proceed.Caption := 'Uninstall';
    Proceed.ModalResult := mrOk;
    Proceed.Default := True;

    // Both buttons sized to the wider caption, the way Inno sizes its own.
    ButtonWidth := Form.CalculateButtonWidth([Proceed.Caption, Stop.Caption]);
    Proceed.Width := ButtonWidth;
    Stop.Width := ButtonWidth;
    Stop.Left := Form.ClientWidth - ScaleX(10) - ButtonWidth;
    Proceed.Left := Stop.Left - ScaleX(6) - ButtonWidth;

    // Focus starts on Uninstall, NOT on the checkbox: the default action is
    // the non-destructive one, and a stray space bar must not tick the box.
    Form.ActiveControl := Proceed;

    if Form.ShowModal = mrOk then
    begin
      DeleteData := Box.Checked;
      Result := True;
    end;
  finally
    Form.Free;
  end;
end;

function InitializeUninstall(): Boolean;
begin
  DeleteUserData := False;
  // A silent uninstall has nobody to ask, so it takes the default answer and
  // keeps the data. The destructive branch is reachable only by a person who
  // ticked a box.
  if UninstallSilent then
  begin
    Result := True;
    Exit;
  end;
  Result := AskWhetherToDeleteUserData(DeleteUserData);
end;

// ---- the logon entry ----------------------------------------------------

// The program a Run value points at, with the installer's quotes and any
// arguments taken off. Returns '' when there is nothing recognisable.
function ProgramFromCommandLine(const Value: String): String;
var
  S: String;
  Q: Integer;
begin
  S := Trim(Value);
  if (Length(S) > 0) and (S[1] = '"') then
  begin
    S := Copy(S, 2, Length(S) - 1);
    Q := Pos('"', S);
    if Q > 0 then
      S := Copy(S, 1, Q - 1)
    else
      S := '';
  end
  else
  begin
    // Unquoted. Both writers of this value quote it, so this is a fallback for
    // a value somebody else's hand wrote, and an unquoted path containing a
    // space is genuinely ambiguous -- it simply will not match ours below,
    // which is the safe way to be wrong.
    Q := Pos(' ', S);
    if Q > 0 then
      S := Copy(S, 1, Q - 1);
  end;
  Result := Trim(S);
end;

// **Removed unconditionally, but only if it is ours.**
//
// The [Registry] entry above carries `uninsdeletevalue`, which sounds like it
// covers this and does not: that flag only removes what setup itself wrote,
// and setup only writes the value when the autostart task was selected. The
// APP also writes it -- `src/autostart_repair.rs`'s `repair_logon_entry`
// rewrites an entry that predates the `--autostart` flag -- so a value setup
// does not own can exist, and on the owner's machine one survived, pointing at
// a deskwarden.exe that was no longer there.
//
// The path is checked before the delete, exactly as `repaired_value` checks it
// before a write, and for the same reason its doc gives: a value pointing
// somewhere else "is not ours to rewrite, whoever put it there" -- nor ours to
// delete. A second Deskwarden installed in another directory keeps its entry.
procedure RemoveOurLogonEntry();
var
  Existing: String;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, LogonKey, LogonValueName, Existing) then
    Exit;
  if CompareText(ProgramFromCommandLine(Existing),
                 ExpandConstant('{app}\deskwarden.exe')) <> 0 then
    Exit;
  RegDeleteValue(HKEY_CURRENT_USER, LogonKey, LogonValueName);
end;

// ---- the PATH entry -----------------------------------------------------

function WithoutTrailingBackslash(const S: String): String;
begin
  Result := S;
  while (Length(Result) > 1) and (Result[Length(Result)] = '\') do
    Result := Copy(Result, 1, Length(Result) - 1);
end;

// Takes {app}\bin back off the user's PATH, and nothing else off it.
//
// `bw_acquire::add_to_user_path` put it there, comparing entry by entry,
// case-insensitively, with trailing separators stripped, because `C:\dir\` and
// `C:\dir` are one directory. This is that comparison run backwards, so the
// entry it wrote is the entry that goes.
//
// Every other entry is copied through VERBATIM -- including empty ones. An
// uninstaller that also tidied a user's PATH would be making an unrequested
// change to a system setting, and the blast radius of getting PATH wrong is
// the whole logon session.
//
// The value is rewritten as REG_EXPAND_SZ when it contains a '%' and REG_SZ
// otherwise. Inno's RegQueryStringValue hands back the UNEXPANDED text, so the
// round trip is lossless either way, and the two types differ in behaviour
// only when there is something to expand -- so this preserves the only
// difference that can be observed.
procedure RemoveOurPathEntry();
var
  Work, Rebuilt, Entry, Ours: String;
  P: Integer;
  Changed, First: Boolean;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, EnvironmentKey, PathValueName, Work) then
    Exit;
  Ours := WithoutTrailingBackslash(ExpandConstant('{app}\bin'));
  Rebuilt := '';
  Changed := False;
  First := True;
  while True do
  begin
    P := Pos(';', Work);
    if P > 0 then
    begin
      Entry := Copy(Work, 1, P - 1);
      Work := Copy(Work, P + 1, Length(Work) - P);
    end
    else
    begin
      Entry := Work;
      Work := '';
    end;
    if CompareText(WithoutTrailingBackslash(Trim(Entry)), Ours) = 0 then
      Changed := True
    else
    begin
      if not First then
        Rebuilt := Rebuilt + ';';
      Rebuilt := Rebuilt + Entry;
      First := False;
    end;
    if P <= 0 then
      Break;
  end;
  // Nothing of ours was in it. Then nothing is written: an uninstall that
  // rewrites PATH byte-for-byte identically still risks losing a change made
  // by something else between the read and the write.
  if not Changed then
    Exit;
  if Pos('%', Rebuilt) > 0 then
    RegWriteExpandStringValue(HKEY_CURRENT_USER, EnvironmentKey, PathValueName, Rebuilt)
  else
    RegWriteStringValue(HKEY_CURRENT_USER, EnvironmentKey, PathValueName, Rebuilt);
end;

// ---- the data, only if asked --------------------------------------------

// The one destructive branch in this file, reachable only from a ticked box.
//
// This is the tree `settings.rs`'s ProjectDirs roots at, holding config/ and
// data/ -- the settings, the per-account sign-in state, the encrypted vault
// copy, the Windows Hello enrolment, the log, and userkey.bin, which wraps the
// master key with DPAPI and never expires.
procedure RemoveUserData();
var
  Root: String;
begin
  Root := ExpandConstant('{userappdata}\Deskwarden\Deskwarden');
  if DirExists(Root) then
    DelTree(Root, True, True, True);
  // Only if empty. The parent is shared by anything else that ever used the
  // same organization name.
  RemoveDir(ExpandConstant('{userappdata}\Deskwarden'));
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  // usPostUninstall: after the files are gone, so nothing here races the
  // removal of the directory these paths are computed from.
  if CurUninstallStep <> usPostUninstall then
    Exit;
  RemoveOurLogonEntry;
  RemoveOurPathEntry;
  if DeleteUserData then
    RemoveUserData;
end;